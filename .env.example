# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development

# Database
# Local default (no Docker): SQLite file inside apps/api
DATABASE_URL=file:./dev.db
# With Docker Postgres instead:
# DATABASE_URL=postgresql://maternity:maternity@localhost:5432/maternity_home

# Redis (optional — carts use in-memory store when Redis is unavailable)
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Public URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STORE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Store contact
STORE_WHATSAPP=+923454105452
STORE_PHONE=+92 3454105452
STORE_EMAIL=hello@thematernityhome.pk

# Media (S3-compatible) — leave empty in early local dev
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Payments — enable only after merchant onboarding
PAYMENT_PROVIDER=mock
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
JAZZCASH_MERCHANT_ID=
EASYPAISA_STORE_ID=
